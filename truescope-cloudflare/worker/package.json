{
  "name": "truescope-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "cpu": "node test/cpu-probe.ts",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply truescope --remote",
    "db:migrate:local": "wrangler d1 migrations apply truescope --local",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.30.0"
  },
  "engines": { "node": ">=22.6" }
}
